# Application
SECRET_KEY=change_this_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL ready - uncomment to use)
# DATABASE_URL=postgresql://user:password@localhost:5432/wi_system
# Default: SQLite for out-of-the-box running
DATABASE_URL=sqlite:///./wi_system.db

# OpenAI (optional - if not set, offline fallback embeddings are used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Path to Work Instruction documents
WI_DOCUMENTS_DIR=../Documents/Digitise instruction Project

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
