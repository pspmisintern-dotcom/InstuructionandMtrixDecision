# Application
SECRET_KEY=change_this_secret_key_in_production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# SMTP (required for admin 2FA login codes — see backend/emailer.py).
# Without these set, OTP codes are only logged to the server console, which
# is fine for local dev but must be configured for production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Database (PostgreSQL ready - uncomment to use)
# DATABASE_URL=postgresql://user:password@localhost:5432/wi_system
# Default: SQLite for out-of-the-box running
DATABASE_URL=

# OpenAI / Ollama (optional - if not set, offline fallback is used)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_PROVIDER=openai
OLLAMA_MODEL=llama2
OLLAMA_API_BASE_URL=http://localhost:11434
OLLAMA_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# Path to Work Instruction documents
WI_DOCUMENTS_DIR=../Documents/Digitise instruction Project

